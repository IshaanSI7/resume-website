/* ---------- COLOR PALETTE & FONTS (CSS variables) ---------- */
:root {
  --navy: #1e2a47;
  --teal: #14b8a6;
  --light: #f4f7fb;
  --text: #333b4d;
  --white: #ffffff;
}

/* ---------- ELEMENT SELECTORS: base styles ---------- */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Inter', sans-serif;
  color: var(--text);
  line-height: 1.7;
  background-color: var(--white);
}

h1, h2, h3 {
  font-family: 'Poppins', sans-serif;
  color: var(--navy);
}

a {
  color: var(--teal);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

/* ---------- NAVIGATION BAR (flexbox + sticky positioning) ---------- */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 8%;
  background-color: var(--navy);
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-family: 'Poppins', sans-serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--white);
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 28px;
}

.nav-links a {
  color: var(--white);
  font-weight: 500;
  transition: color 0.3s;
}

.nav-links a:hover {
  color: var(--teal);
  text-decoration: none;
}

/* ---------- HERO SECTION (ID selector) ---------- */
#home {
  min-height: 80vh;
}

.hero {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 60px 8%;
  background: linear-gradient(135deg, var(--navy), #2d4a7a);
}

.hero h1 {
  color: var(--white);
  font-size: 3.2rem;
  margin: 8px 0;
}

.hero-small {
  color: var(--teal);
  font-size: 1.2rem;
  font-weight: 500;
}

.hero-role {
  color: #cbd5e1;
  font-size: 1.4rem;
  margin-bottom: 28px;
}

.btn {
  background-color: var(--teal);
  color: var(--white);
  padding: 12px 32px;
  border-radius: 30px;
  font-weight: 600;
  transition: transform 0.3s, background-color 0.3s;
}

.btn:hover {
  background-color: #0f9488;
  transform: translateY(-3px);
  text-decoration: none;
}

/* ---------- GENERAL SECTIONS ---------- */
.section {
  padding: 70px 8%;
  text-align: center;
}

.section.alt {
  background-color: var(--light);
}

.section h2 {
  font-size: 2rem;
  margin-bottom: 30px;
  position: relative;
}

/* small teal underline under each heading */
.section h2::after {
  content: "";
  display: block;
  width: 60px;
  height: 4px;
  background-color: var(--teal);
  margin: 10px auto 0;
  border-radius: 2px;
}

.about-text {
  max-width: 700px;
  margin: 0 auto 10px;
  font-size: 1.1rem;
}

/* ---------- CARDS (flexbox layout) ---------- */
.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24px;
}

.card {
  flex: 1 1 280px;
  max-width: 340px;
  background-color: var(--white);
  padding: 28px;
  border-radius: 12px;
  text-align: left;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  border-top: 4px solid var(--teal);
  transition: transform 0.3s, box-shadow 0.3s;
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
}

.card h3 {
  margin-bottom: 6px;
  font-size: 1.15rem;
}

.meta {
  color: var(--teal);
  font-weight: 500;
  font-size: 0.9rem;
  margin-bottom: 10px;
}

/* ---------- SKILLS (pill badges) ---------- */
.skills {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
  list-style: none;
  max-width: 700px;
  margin: 0 auto;
}

.skills li {
  background-color: var(--navy);
  color: var(--white);
  padding: 10px 24px;
  border-radius: 30px;
  font-weight: 500;
  transition: background-color 0.3s;
}

.skills li:hover {
  background-color: var(--teal);
}

/* ---------- FOOTER ---------- */
.footer {
  background-color: var(--navy);
  color: #cbd5e1;
  text-align: center;
  padding: 22px;
  font-size: 0.9rem;
}

/* ---------- RESPONSIVE (small screens) ---------- */
@media (max-width: 700px) {
  .navbar {
    flex-direction: column;
    gap: 10px;
  }
  .nav-links {
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero h1 {
    font-size: 2.2rem;
  }
}
